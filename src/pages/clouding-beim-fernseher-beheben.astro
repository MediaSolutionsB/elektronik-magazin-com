          '@type': 'ImageObject',
          'url': site.url + '/bilder/em-icon.webp'
        }
      },
      'mainEntityOfPage': site.url + canonicalPath
    },
    {
      '@type': 'FAQPage',
      'mainEntity': [
        {
          '@type': 'Question',
          'name': 'Was ist Clouding beim Fernseher genau?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Clouding (auch Taschenlampeneffekt oder Flashlighting genannt) bezeichnet eine ungleichmäßige Ausleuchtung bei LCD- und LED-Fernsehern. In dunklen oder schwarzen Filmszenen werden helle, wolkige Flecken oder Lichtkegel aus den Display-Ecken sichtbar.'
          }
        },
        {
          '@type': 'Question',
          'name': 'Kann man Clouding beim Fernseher selbst beheben?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Ja, in den meisten Fällen lässt sich Clouding deutlich reduzieren: 1. Durch Drosseln der Hintergrundbeleuchtung (Backlight) im TV-Menü. 2. Durch den sanften Massage-Trick mit einem Mikrofasertuch bei warmem Panel. 3. Durch leichtes Lockern der Gehäuseschrauben um eine Vierteldrehung. 4. Durch Anbringen einer indirekten Hintergrundbeleuchtung (Bias Lighting).'
          }
        },
        {
          '@type': 'Question',
          'name': 'Ist Clouding ein Reklamations- oder Garantiefall?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Die meisten Hersteller wie Samsung, LG, Sony oder Philips stufen leichtes bis mittleres Clouding als bauartbedingte Eigenschaft von Edge-LED-Displays ein und lehnen eine Garantiereparatur oft ab. Bei Neugeräten empfiehlt sich daher die sofortige Rückgabe über das 14-tägige Widerrufsrecht beim Onlinekauf.'
          }
        },
        {
          '@type': 'Question',
          'name': 'Haben OLED-Fernseher auch Clouding?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Nein. OLED-Fernseher besitzen keine Hintergrundbeleuchtung, sondern selbstleuchtende Pixel. Jeder Pixel schaltet sich bei Schwarz komplett ab. Daher sind OLED-Geräte physikalisch zu 100 % frei von Clouding und Taschenlampeneffekten.'
          }
        },
        {
          '@type': 'Question',
          'name': 'Verschwindet Clouding mit der Zeit von alleine?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Gelegentlich kann sich frisch aufgetretenes Clouding nach einigen Betriebswochen etwas mildern, wenn sich fertigungsbedingte Materialspannungen im TV-Gehäuse durch wiederholte Erwärmung und Abkühlung abbauen. Meist bleibt das Phänomen jedoch ohne gezielte Maßnahmen dauerhaft bestehen.'
          }
        }
      ]
    }
  ]
};
