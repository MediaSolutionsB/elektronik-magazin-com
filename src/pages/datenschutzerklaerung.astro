---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
const html = fs.readFileSync('content/legal/datenschutz.html', 'utf-8');
---
<Base title="Datenschutzerklärung" path="/datenschutzerklaerung/" noindex={true}>
  <article class="em-article-wrap">
    <header class="em-article-header">
      <h1 style="font-size: clamp(28px, 3.8vw, 42px);">Datenschutzerklärung</h1>
    </header>
    <div class="em-content" set:html={html} />
  </article>
</Base>
