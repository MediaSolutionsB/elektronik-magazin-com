---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config.js';
import fs from 'node:fs';
import path from 'node:path';

const indexFile = path.resolve('content/tools/index.json');
const tools = JSON.parse(fs.readFileSync(indexFile, 'utf-8'));
---
<Base title="Online-Rechner & Tools" description="Kostenlose Rechner für Stromkosten, Watt in kWh, Sitzabstand zum TV, Akkukapazität und Speichergrößen." path="/tools/">
  <div class="em-wrap" style="padding-top: 56px; padding-bottom: 72px;">
    <header style="margin-bottom: 40px; text-align: center;">
      <span class="em-eyebrow">Praktische Hilfsmittel</span>
      <h1 style="font-size: clamp(32px, 4vw, 48px); margin-top: 10px;">Online-Rechner für Technik & Energie</h1>
      <p style="color: var(--muted); max-width: 600px; margin: 12px auto 0;">Präzise Berechnungen für deinen Alltag – vom TV-Sitzabstand bis hin zu Stromverbrauch und Akkukapazitäten.</p>
    </header>

    <div class="em-cards">
      {tools.map((t) => (
        <a class="em-card" href={`/tools/${t.slug}/`}>
          <div class="em-card-body">
            <span class="em-pill em-pill-blue">Rechner</span>
            <div class="em-card-title" style="margin-top: 8px;">{t.title}</div>
            <div class="em-card-text">{t.excerpt || 'Kostenloser Online-Rechner mit direkter Sofort-Berechnung.'}</div>
            <div class="em-card-more">Jetzt berechnen &rarr;</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
