---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '../styles/site.css';
import { site } from '../site.config.js';

const {
  title,
  description = site.tagline,
  image = '/bilder/logo-2020-jpg.webp',
  path = '/',
  noindex = false,
  type = 'website',
  jsonld = null
} = Astro.props;

const canonical = site.url + path;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${site.name}` : `${site.name} – Tests, Ratgeber & Rechner`}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {image && <meta property="og:image" content={image.startsWith('http') ? image : site.url + image} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="em-skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="em-header">
      <div class="em-wrap em-header-inner">
        <a class="em-logo" href="/">
          <img src="/bilder/em-icon.webp" alt="Elektronik Magazin Emblem" width="38" height="38" class="em-logo-icon" />
          <span class="em-logo-text">Elektronik<span class="em-logo-accent">-Magazin</span></span>
        </a>
        <div class="em-search-wrapper" id="em-site-search">
          <div class="em-search-box">
            <svg class="em-search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="8.5" cy="8.5" r="5.5"></circle>
              <line x1="12.5" y1="12.5" x2="17.5" y2="17.5"></line>
            </svg>
            <input
              type="search"
              class="em-search-input"
              id="em-search-input"
              placeholder="Themen, Tests, Rechner suchen..."
              autocomplete="off"
              aria-label="Website durchsuchen"
            />
            <kbd class="em-search-kbd" title="Tastaturkürzel">Ctrl K</kbd>
            <button type="button" class="em-search-clear" id="em-search-clear" aria-label="Suche zurücksetzen" style="display:none;">&times;</button>
          </div>
          <div class="em-search-dropdown" id="em-search-dropdown" style="display:none;">
            <div class="em-search-results" id="em-search-results"></div>
            <div class="em-search-footer" id="em-search-footer">
              <span>Tipp: Suche nach Geräten, Marken oder Rechnern</span>
              <span>ESC zum Schließen</span>
            </div>
          </div>
        </div>
        <input type="checkbox" id="em-nav-toggle" class="em-nav-toggle" />
        <label for="em-nav-toggle" class="em-nav-button"><span>Menü</span></label>
        <nav class="em-nav" aria-label="Hauptmenü">
          <a href="/tests/">Tests &amp; Checks</a>
          <a href="/ratgeber/">Ratgeber</a>
          <a href="/tools/">Online-Rechner</a>
          <a class="em-nav-service" href="/elektronik-services/">Vor-Ort-Service</a>
        </nav>
      </div>
    </header>
    <main id="inhalt">
      <slot />
    </main>
    <footer class="em-footer">
      <div class="em-wrap">
        <div class="em-footer-cols">
          <div class="em-footer-about">
            <a class="em-logo em-logo-footer" href="/">
              <img src="/bilder/em-icon.webp" alt="Elektronik Magazin Emblem" width="34" height="34" class="em-logo-icon" />
              <span class="em-logo-text">Elektronik<span class="em-logo-accent">-Magazin</span></span>
            </a>
            <p style="margin: 8px 0 12px; color: var(--on-dark); font-size: 15px; line-height: 1.5;">{site.tagline}</p>
            <span style="font-size: 14px; color: #cbd5e1; display: block;">Region Stuttgart &amp; Rems-Murr-Kreis</span>
          </div>
          <div>
            <span class="em-footer-head">Vor-Ort-Service</span>
            <div class="em-footer-nav">
              <a href="/elektronik-services/#pc-laptop">PC &amp; Laptop Einrichtung</a>
              <a href="/elektronik-services/#tv-montage">TV-Wandmontage</a>
              <a href="/elektronik-services/#haushaltsgeraete">Haushaltsgeräte-Anschluss</a>
              <a href="/elektronik-services/#smart-home">Smart Home &amp; WLAN</a>
              <a href="/elektronik-services/">Alle Leistungen &rarr;</a>
            </div>
          </div>
          <div>
            <span class="em-footer-head">Themen &amp; Rechner</span>
            <div class="em-footer-nav">
              <a href="/ratgeber/">Ratgeber &amp; Tests</a>
              <a href="/tools/">Online-Rechner</a>
              <a href="/tools/stromkosten-rechner/">Stromkosten Rechner</a>
              <a href="/tools/sitzabstand-rechner-fernseher/">TV-Sitzabstand Rechner</a>
              <a href="/individuelle-kaufberatung/">Kaufberatung</a>
            </div>
          </div>
          <div>
            <span class="em-footer-head">Magazin &amp; Rechtliches</span>
            <div class="em-footer-nav">
              <a href="/ueber-uns/">Über Uns</a>
              <a href="/oliver-bechstein/">Oliver Bechstein (Autor)</a>
              <a href="/kontakt/">Kontakt</a>
              <a href="/impressum/">Impressum</a>
              <a href="/datenschutzerklaerung/">Datenschutzerklärung</a>
              <a href="/sitemap-html/">Sitemap</a>
            </div>
          </div>
        </div>
        <div class="em-footer-bottom">
          <span>&copy; {year} {site.name}. Alle Rechte vorbehalten.</span>
          <span>Links zu Händlern sind Partnerlinks. Kaufst du darüber ein, erhalten wir eine kleine Provision. Dein Preis ändert sich dadurch nicht. Als Amazon-Partner verdiene ich an qualifizierten Verkäufen.</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      // YouTube erst nach Klick laden (vorher keine Verbindung zu YouTube)
      document.addEventListener('click', function (e) {
        var b = e.target.closest('.em-video-play');
        if (!b) return;
        var box = b.closest('.em-video');
        var f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + box.dataset.video + '?autoplay=1&rel=0';
        f.title = box.dataset.title || 'Video';
        f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        f.allowFullscreen = true;
        box.innerHTML = '';
        box.appendChild(f);
      });

      // Header Live-Suche
      (function() {
        var input = document.getElementById('em-search-input');
        var wrapper = document.getElementById('em-site-search');
        var dropdown = document.getElementById('em-search-dropdown');
        var resultsBox = document.getElementById('em-search-results');
        var clearBtn = document.getElementById('em-search-clear');
        var kbd = wrapper ? wrapper.querySelector('.em-search-kbd') : null;
        if (!input || !dropdown || !resultsBox) return;

        var searchIndex = null;
        var isLoading = false;
        var selectedIndex = -1;

        function loadIndex(callback) {
          if (searchIndex) {
            if (callback) callback(searchIndex);
            return;
          }
          if (isLoading) return;
          isLoading = true;
          fetch('/suchindex.json')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              searchIndex = data;
              isLoading = false;
              if (callback) callback(searchIndex);
            })
            .catch(function(err) {
              console.error('Fehler beim Laden des Suchindex:', err);
              isLoading = false;
            });
        }

        wrapper.addEventListener('mouseenter', function() { loadIndex(); });
        wrapper.addEventListener('touchstart', function() { loadIndex(); }, { passive: true });

        function escapeHtml(str) {
          return (str || '').replace(/[&<>"']/g, function(m) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
          });
        }

        function highlightMatch(text, query) {
          if (!query) return escapeHtml(text);
          var escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          var regex = new RegExp('(' + escapedQuery + ')', 'gi');
          return escapeHtml(text).replace(regex, '<mark>$1</mark>');
        }

        function renderResults(query) {
          if (!searchIndex) {
            resultsBox.innerHTML = '<div class="em-search-empty">Lade Suchindex...</div>';
            dropdown.style.display = 'flex';
            return;
          }

          var q = query.trim().toLowerCase();
          if (!q) {
            dropdown.style.display = 'none';
            if (clearBtn) clearBtn.style.display = 'none';
            if (kbd) kbd.style.display = '';
            return;
          }

          if (clearBtn) clearBtn.style.display = 'inline-flex';
          if (kbd) kbd.style.display = 'none';

          var terms = q.split(/\s+/).filter(Boolean);
          var matches = searchIndex.filter(function(item) {
            var haystack = ((item.title || '') + ' ' + (item.fullTitle || '') + ' ' + (item.category || '') + ' ' + (item.excerpt || '')).toLowerCase();
            return terms.every(function(t) { return haystack.indexOf(t) !== -1; });
          }).slice(0, 8);

          selectedIndex = -1;

          if (matches.length === 0) {
            resultsBox.innerHTML = '<div class="em-search-empty">Keine Ergebnisse f\u00FCr <strong>\u201E' + escapeHtml(q) + '\u201C</strong> gefunden.</div>';
          } else {
            var html = matches.map(function(item, idx) {
              var badgeClass = 'em-badge-check';
              if (item.type === 'Test') badgeClass = 'em-badge-test';
              else if (item.type === 'Ratgeber') badgeClass = 'em-badge-ratgeber';
              else if (item.type === 'Rechner') badgeClass = 'em-badge-rechner';

              var scoreHtml = item.score ? '<span class="em-pill" style="font-size:11px;padding:2px 6px;">' + item.score + '/100</span>' : '';

              return '<a class="em-search-item" href="' + item.url + '" data-index="' + idx + '">' +
                '<div class="em-search-item-top">' +
                  '<span class="em-search-item-badge ' + badgeClass + '">' + item.type + '</span>' +
                  '<span class="em-search-item-cat">' + escapeHtml(item.category) + '</span>' +
                  scoreHtml +
                '</div>' +
                '<div class="em-search-item-title">' + highlightMatch(item.title, terms[0]) + '</div>' +
                (item.excerpt ? '<div class="em-search-item-desc">' + escapeHtml(item.excerpt) + '</div>' : '') +
              '</a>';
            }).join('');
            resultsBox.innerHTML = html;
          }

          dropdown.style.display = 'flex';
        }

        input.addEventListener('focus', function() {
          loadIndex(function() {
            if (input.value.trim()) {
              renderResults(input.value);
            }
          });
        });

        input.addEventListener('input', function() {
          loadIndex(function() {
            renderResults(input.value);
          });
        });

        if (clearBtn) {
          clearBtn.addEventListener('click', function() {
            input.value = '';
            dropdown.style.display = 'none';
            clearBtn.style.display = 'none';
            if (kbd) kbd.style.display = '';
            input.focus();
          });
        }

        input.addEventListener('keydown', function(e) {
          var items = resultsBox.querySelectorAll('.em-search-item');
          if (!items.length || dropdown.style.display === 'none') {
            if (e.key === 'Escape') dropdown.style.display = 'none';
            return;
          }

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedIndex = (selectedIndex + 1) % items.length;
            updateSelection(items);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedIndex = (selectedIndex - 1 + items.length) % items.length;
            updateSelection(items);
          } else if (e.key === 'Enter') {
            if (selectedIndex >= 0 && items[selectedIndex]) {
              e.preventDefault();
              items[selectedIndex].click();
            }
          } else if (e.key === 'Escape') {
            dropdown.style.display = 'none';
          }
        });

        function updateSelection(items) {
          items.forEach(function(el, idx) {
            if (idx === selectedIndex) {
              el.classList.add('is-selected');
              el.scrollIntoView({ block: 'nearest' });
            } else {
              el.classList.remove('is-selected');
            }
          });
        }

        document.addEventListener('keydown', function(e) {
          if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
            e.preventDefault();
            input.focus();
            input.select();
          }
        });

        document.addEventListener('click', function(e) {
          if (wrapper && !wrapper.contains(e.target)) {
            dropdown.style.display = 'none';
          }
        });
      })();
    </script>
  </body>
</html>
