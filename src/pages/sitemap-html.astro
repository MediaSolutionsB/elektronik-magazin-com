---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';
import { allReviews, urlOf } from '../lib/reviews.js';
import { tools } from '../rechner/tools.js';
const reviews = allReviews();
const ratgeber = JSON.parse(fs.readFileSync(path.resolve('content/ratgeber/index.json'), 'utf-8'));
const seiten = [['/test/', 'Tests'], ['/check/', 'Praxis-Checks'], ['/elektronik-services/', 'Vor-Ort-Service'], ['/individuelle-kaufberatung/', 'Individuelle Kaufberatung'], ['/installationsservice-fuer-heimkino-und-hifi-systeme/', 'Installationsservice für Heimkino- und HiFi-Systeme'], ['/fernwartung-und-technischer-support/', 'Fernwartung und technischer Support'], ['/ueber-uns/', 'Über uns'], ['/oliver-bechstein/', 'Oliver Bechstein (Autor)'], ['/kontakt/', 'Kontakt'], ['/impressum/', 'Impressum'], ['/datenschutzerklaerung/', 'Datenschutzerklärung']];
---
<Base title="Sitemap" path="/sitemap-html/">
  <article class="em-article-wrap">
    <header class="em-article-header"><h1 style="font-size: clamp(28px, 3.8vw, 42px);">Sitemap</h1></header>
    <div class="em-content">
      <h2>Tests und Beiträge</h2>
      <ul>{reviews.map((r) => <li><a href={urlOf(r)}>{r.title}</a></li>)}</ul>
      <h2>Online-Rechner</h2>
      <ul>{tools.map((t) => <li><a href={`/tools/${t.slug}/`}>{t.name}</a></li>)}</ul>
      <h2>Ratgeber</h2>
      <ul>{ratgeber.map((g) => <li><a href={`/ratgeber/${g.slug}/`}>{g.title}</a></li>)}</ul>
      <h2>Seiten</h2>
      <ul>{seiten.map(([u, n]) => <li><a href={u}>{n}</a></li>)}</ul>
    </div>
  </article>
</Base>
