---
import Base from '../../layouts/Base.astro';
import { tools, gruppen } from '../../rechner/tools.js';
import { icons, arrow } from '../../lib/icons.js';
---
<Base title="Online-Rechner für Fernseher, Heimkino, Strom und PC" description="27 kostenlose Online-Rechner von Elektronik-Magazin: TV-Größe, Sitzabstand, Montagehöhe, Beamer, Lautsprecher-Aufstellung, HDMI-Bandbreite, Stromkosten, Powerbank, Download-Zeit, RAID und mehr. Sofort im Browser." path="/tools/">
  <section class="em-pagehead">
    <div class="em-wrap">
      <nav class="em-crumbs" aria-label="Brotkrumen"><a href="/">Startseite</a><span aria-hidden="true">/</span><span>Online-Rechner</span></nav>
      <h1>Online-Rechner</h1>
      <p>Schnell ausrechnen statt schätzen: Wie groß darf der Fernseher sein und wie hoch gehört er an die Wand? Wo stehen die Lautsprecher, reicht HDMI 2.0, was kostet ein Gerät an Strom? Alle Rechner sind kostenlos und rechnen direkt in deinem Browser.</p>
    </div>
  </section>
  <nav class="em-wrap em-tool-jump" aria-label="Themen">
    {gruppen.map((g) => <a href={`#${g.id}`}>{g.name}</a>)}
  </nav>
  {gruppen.map((g) => (
    <section class="em-wrap em-section" id={g.id}>
      <div class="em-section-head"><h2>{g.name}</h2></div>
      <div class="em-tools">
        {tools.filter((t) => t.gruppe === g.id).map((t) => (
          <a class="em-tool" href={`/tools/${t.slug}/`}>
            <span class="em-cat-ico"><Fragment set:html={icons[t.icon]} /></span>
            <span class="em-tool-name">{t.name}</span>
            <span class="em-tool-text">{t.kurz}</span>
            <span class="em-tool-more">Jetzt ausrechnen <Fragment set:html={arrow} /></span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
