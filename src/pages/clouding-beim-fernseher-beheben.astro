const heroImage = '/bilder/clouding/clouding-fernseher-beispiel.webp';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      'headline': pageTitle,
      'description': pageDescription,
      'image': site.url + heroImage,
      'datePublished': '2017-08-15T12:00:00+02:00',
      'dateModified': '2026-10-14T11:00:00+02:00',
      'author': {
        '@type': 'Person',
        'name': site.author.name,
        'url': site.url + '/oliver-bechstein/',
        'image': site.url + site.author.image,
        'description': site.author.bio
      },
      'publisher': {
        '@type': 'Organization',
        'name': site.name,
        'url': site.url,
