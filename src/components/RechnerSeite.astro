---
// Gemeinsamer Rahmen aller Rechner: Kopf, Eingaben links, Ergebnis rechts, darunter Erklärung und Quellen.
import Base from '../layouts/Base.astro';
import { site } from '../site.config.js';
import { tools } from '../rechner/tools.js';
import { icons, arrow } from '../lib/icons.js';
const { slug, title, h1, intro, description } = Astro.props;
const tool = tools.find((t) => t.slug === slug);
const cat = site.categories.find((c) => c.slug === tool?.kategorie);
const andere = tools.filter((t) => t.slug !== slug && t.gruppe === tool?.gruppe).concat(tools.filter((t) => t.slug !== slug && t.gruppe !== tool?.gruppe)).slice(0, 4);
const path = `/tools/${slug}/`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool?.name || h1,
  url: site.url + path,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Alle (läuft im Browser)',
  inLanguage: 'de-DE',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
};
---
<Base title={title} description={description} path={path} jsonld={jsonld}>
  <section class="em-pagehead">
    <div class="em-wrap">
      <nav class="em-crumbs" aria-label="Brotkrumen">
        <a href="/">Startseite</a><span aria-hidden="true">/</span>
        <a href="/tools/">Online-Rechner</a><span aria-hidden="true">/</span>
        <span>{tool?.name}</span>
      </nav>
      <h1>{h1}</h1>
      <p>{intro}</p>
    </div>
  </section>

  <div class="em-wrap em-calc" data-rechner={slug}>
    <form class="em-calc-form" onsubmit="return false" autocomplete="off">
      <slot name="eingaben" />
    </form>
    <div class="em-calc-result" aria-live="polite">
      <slot name="ergebnis" />
    </div>
  </div>

  <div class="em-wrap em-calc-info">
    <section class="em-text">
      <slot name="info" />
      <p class="em-calc-hint">Alle Werte sind Richtwerte zur Orientierung. Maßgeblich sind die Angaben auf dem Typenschild bzw. in der Anleitung deines Geräts. Der Rechner läuft komplett in deinem Browser, es werden keine Daten gespeichert oder verschickt.</p>
    </section>
    <aside class="em-calc-more">
      {cat && <a class="em-calc-cat" href={`/kategorie/${cat.slug}/`}><span>Passende Tests und Checks</span><strong>{cat.name}</strong><Fragment set:html={arrow} /></a>}
      <span class="em-calc-more-head">Weitere Rechner</span>
      {andere.map((t) => (
        <a class="em-calc-link" href={`/tools/${t.slug}/`}><span class="em-calc-link-ico"><Fragment set:html={icons[t.icon]} /></span><span>{t.name}</span></a>
      ))}
      <a class="em-calc-all" href="/tools/">Alle Online-Rechner</a>
    </aside>
  </div>
</Base>
