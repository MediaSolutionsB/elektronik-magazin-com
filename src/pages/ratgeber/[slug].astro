---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config.js';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const indexFile = path.resolve('content/ratgeber/index.json');
  const items = JSON.parse(fs.readFileSync(indexFile, 'utf-8'));
  return items
    .filter((item) => fs.existsSync(path.resolve(`content/ratgeber/${item.slug}/content.html`)))
    .map((item) => ({
      params: { slug: item.slug },
      props: { meta: item }
    }));
}

const { meta } = Astro.props;
const file = path.resolve(`content/ratgeber/${meta.slug}/content.html`);
const contentHtml = fs.readFileSync(file, 'utf-8');
---
<Base
  title={meta.title}
  description={meta.excerpt || `${meta.title} – Ausführlicher Ratgeber bei Elektronik Magazin`}
  path={`/ratgeber/${meta.slug}/`}
>
  <article class="em-article-wrap">
    <header class="em-article-header">
      <div class="em-pill">Ratgeber & Kaufberatung</div>
      <h1 style="font-size: clamp(28px, 3.8vw, 42px); margin-top: 14px;">{meta.title}</h1>
      <div class="em-article-meta">
        <span>Von <strong>Oliver Bechstein</strong></span>
        <span>&bull;</span>
        <span>Kaufberatung & Tipps</span>
      </div>
    </header>

    {meta.image && (
      <figure style="margin: 24px 0 32px;">
        <img class="em-lead-img" src={meta.image} alt={meta.title} width="1280" height="720" style="aspect-ratio: 16/9; object-fit: cover;" />
      </figure>
    )}

    <div class="em-content" set:html={contentHtml} />
  </article>
</Base>
