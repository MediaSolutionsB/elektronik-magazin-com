---
// Zahlenfeld mit Einheit. Komma und Punkt werden beide akzeptiert.
const { id, label, unit = '', value = '', hint = '' } = Astro.props;
---
<label class="em-field" for={id}>
  <span>{label}</span>
  <span class="em-input"><input id={id} name={id} type="text" inputmode="decimal" value={value} />{unit && <em>{unit}</em>}</span>
  {hint && <small>{hint}</small>}
</label>
