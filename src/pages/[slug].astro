---
import Beitrag from '../components/Beitrag.astro';
import { allReviews } from '../lib/reviews.js';

// Alte Beiträge aus WordPress behalten ihre Adresse direkt hinter der Domain.
export function getStaticPaths() {
  return allReviews().filter((r) => r.path).map((r) => ({ params: { slug: r.slug }, props: { review: r } }));
}
const { review } = Astro.props;
---
<Beitrag review={review} />
