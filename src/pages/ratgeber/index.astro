---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config.js';
import fs from 'node:fs';
import path from 'node:path';

const indexFile = path.resolve('content/ratgeber/index.json');
const guides = JSON.parse(fs.readFileSync(indexFile, 'utf-8'));

const reviewsFile = path.resolve('content/reviews/index.json');
const reviews = JSON.parse(fs.readFileSync(reviewsFile, 'utf-8'));
---
<Base title="Ratgeber & Praxistests" description="Unabhängige Kaufberater, Tests und Technik-Ratgeber von Elektronik Magazin." path="/ratgeber/">
  <div class="em-wrap" style="padding-top: 56px; padding-bottom: 72px;">
    <header style="margin-bottom: 40px; text-align: center;">
      <span class="em-eyebrow">Wissen & Tests</span>
      <h1 style="font-size: clamp(32px, 4vw, 48px); margin-top: 10px;">Ratgeber, Kaufberatung & Hardware-Tests</h1>
      <p style="color: var(--muted); max-width: 600px; margin: 12px auto 0;">Finde das passende Produkt mit unseren fundierten Kaufberatungen und aktuellen Praxistests.</p>
    </header>

    <div class="em-section-head">
      <h2>Kaufberater & Tests</h2>
    </div>
    <div class="em-cards" style="margin-bottom: 56px;">
      {guides.map((g) => (
        <a class="em-card" href={`/ratgeber/${g.slug}/`}>
          <div class="em-card-body">
            <span class="em-pill">Kaufberatung</span>
            <div class="em-card-title" style="margin-top: 8px;">{g.title}</div>
            <div class="em-card-text">{g.excerpt || 'Umfassender Ratgeber mit praktischen Entscheidungshilfen.'}</div>
            <div class="em-card-more">Ratgeber lesen &rarr;</div>
          </div>
        </a>
      ))}
    </div>

    <div class="em-section-head">
      <h2>Aktuelle Hardware-Praxistests</h2>
    </div>
    <div class="em-cards">
      {reviews.map((r) => (
        <a class="em-card" href={`/${r.slug}/`}>
          <img src={r.featured_image} alt={r.title} />
          <div class="em-card-body">
            <span class="em-pill">{r.categories[0] || 'Praxistest'}</span>
            <div class="em-card-title" style="margin-top: 8px;">{r.title}</div>
            <div class="em-card-text">{r.excerpt?.slice(0, 110)}...</div>
            <div class="em-card-more">Zum Testbericht &rarr;</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
