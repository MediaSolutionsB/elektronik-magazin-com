---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.js';
import fs from 'node:fs';
import path from 'node:path';

const indexFile = path.resolve('content/reviews/index.json');
const allPosts = JSON.parse(fs.readFileSync(indexFile, 'utf-8'));
const featuredPost = allPosts[0];
const recentPosts = allPosts.slice(1);

const tools = [
  { slug: 'stromkosten-rechner', title: 'Stromkosten Rechner', desc: 'Berechne den genauen Stromverbrauch und die Kosten deiner Elektrogeräte.' },
  { slug: 'sitzabstand-rechner-fernseher', title: 'Sitzabstand zum Fernseher', desc: 'Der optimale Abstand zum TV für 4K-, OLED- und Full-HD-Geräte.' },
  { slug: 'watt-in-kwh-umrechnen', title: 'Watt in kWh umrechnen', desc: 'Einfacher Online-Rechner für Kilowattstunden und Watt-Leistung.' },
  { slug: 'volt-watt-in-ampere-umrechnen', title: 'Volt, Watt & Ampere Rechner', desc: 'Formelrechner für elektrische Stromstärke, Leistung und Spannung.' },
  { slug: 'mwh-in-kwh-umrechnen', title: 'mWh in kWh umrechnen', desc: 'Umrechner für Akkukapazitäten von Smartphones, Laptops und Powerbanks.' },
  { slug: 'lumen-in-watt-umrechnen-led', title: 'Lumen in Watt (LED)', desc: 'Helligkeit von LED-Lampen mit herkömmlichen Glühbirnen vergleichen.' },
  { slug: 'rechner-kilobyte-kb-megabyte-mb-gigabyte-gb-und-terabyte-tb-umrechnen', title: 'Speichergrößen-Rechner', desc: 'kB, MB, GB und TB sekundenschnell exakt umrechnen.' },
];
---
<Base title="Elektronik Magazin – Unabhängige Tests, Ratgeber & Rechner" path="/">
  <section class="em-hero">
    <div class="em-wrap em-hero-inner">
      <div class="em-hero-text">
        <span class="em-hero-tag">Elektronik & Technik Magazin</span>
        <h1>Echte Tests. Klare Kaufberatung. Smarte Rechner.</h1>
        <p>Unabhängige Praxistests von Smartphones, Audio, Netzwerk & Smart Home – plus präzise Online-Rechner für Stromkosten und Akkukapazität.</p>
        <div class="em-hero-actions">
          <a class="em-btn" href="/tools/">Zu den Online-Rechnern</a>
          <a class="em-btn em-btn-ghost" href="/ratgeber/">Alle Ratgeber & Tests</a>
        </div>
      </div>
      {featuredPost && (
        <a class="em-feature" href={`/${featuredPost.slug}/`}>
          <img src={featuredPost.featured_image} alt={featuredPost.title} />
          <div class="em-feature-body">
            <span class="em-eyebrow">Aktueller Praxistest</span>
            <div class="em-feature-title">{featuredPost.title}</div>
            <div class="em-feature-text">{featuredPost.excerpt?.slice(0, 140)}...</div>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="em-section">
    <div class="em-wrap">
      <div class="em-section-head">
        <div>
          <span class="em-eyebrow">Neueste Hardware-Tests</span>
          <h2>Praxistests & Erfahrungsberichte</h2>
        </div>
        <a href="/ratgeber/">Alle Tests ansehen &rarr;</a>
      </div>
      <div class="em-cards">
        {recentPosts.map((post) => (
          <a class="em-card" href={`/${post.slug}/`}>
            <img src={post.featured_image} alt={post.title} />
            <div class="em-card-body">
              <div class="em-card-top">
                <span class="em-pill">{post.categories[0] || 'Hardware'}</span>
                <span style="font-size: 14px; color: var(--muted);">{post.date}</span>
              </div>
              <div class="em-card-title">{post.title}</div>
              <div class="em-card-text">{post.excerpt?.slice(0, 110)}...</div>
              <div class="em-card-more">Testbericht lesen &rarr;</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="em-section" style="background: #ffffff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="em-wrap">
      <div class="em-section-head">
        <div>
          <span class="em-eyebrow">Tools & Helfer</span>
          <h2>Praktische Online-Rechner</h2>
        </div>
        <a href="/tools/">Alle Rechner &rarr;</a>
      </div>
      <div class="em-cards">
        {tools.map((tool) => (
          <a class="em-card" href={`/tools/${tool.slug}/`}>
            <div class="em-card-body">
              <span class="em-pill em-pill-blue">Interaktives Tool</span>
              <div class="em-card-title" style="margin-top: 8px;">{tool.title}</div>
              <div class="em-card-text">{tool.desc}</div>
              <div class="em-card-more">Rechner öffnen &rarr;</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="em-section" style="background: var(--ground); border-bottom: 1px solid var(--line);">
    <div class="em-wrap">
      <div class="em-section-head">
        <div>
          <span class="em-eyebrow">Vor-Ort-Service · Stuttgart & Rems-Murr-Kreis</span>
          <h2>Technik- & Installationsservice bei dir zu Hause</h2>
        </div>
        <a href="/elektronik-services/">Alle Details zum Service &rarr;</a>
      </div>
      <div class="em-cards">
        <a class="em-card" href="/elektronik-services/#pc-laptop">
          <div class="em-card-body">
            <span class="em-pill">PC & Laptop</span>
            <div class="em-card-title" style="margin-top: 8px;">Einrichtung & Installation von PC und Laptop</div>
            <div class="em-card-text">Ersteinrichtung, sichere Datenübernahme vom Altgerät, WLAN-, Software- und Drucker-Setup vor Ort.</div>
            <div class="em-card-more">Mehr erfahren &rarr;</div>
          </div>
        </a>
        <a class="em-card" href="/elektronik-services/#tv-montage">
          <div class="em-card-body">
            <span class="em-pill">TV & Heimkino</span>
            <div class="em-card-title" style="margin-top: 8px;">Aufbau & Wandmontage von Fernsehgeräten</div>
            <div class="em-card-text">Fachgerechte Wandhalterung für OLED, QLED & LED, saubere Kabelführung und Smart-TV-Einrichtung.</div>
            <div class="em-card-more">Mehr erfahren &rarr;</div>
          </div>
        </a>
        <a class="em-card" href="/elektronik-services/#haushaltsgeraete">
          <div class="em-card-body">
            <span class="em-pill">Küche & Haushalt</span>
            <div class="em-card-title" style="margin-top: 8px;">Installation von Küchen- & Haushaltsgeräten</div>
            <div class="em-card-text">Fachgerechter Anschluss von Waschmaschine, Spülmaschine, Trockner und Kühlschrank inkl. Dichtigkeitsprüfung.</div>
            <div class="em-card-more">Mehr erfahren &rarr;</div>
          </div>
        </a>
        <a class="em-card" href="/elektronik-services/#smart-home">
          <div class="em-card-body">
            <span class="em-pill">Smart Home & WLAN</span>
            <div class="em-card-title" style="margin-top: 8px;">Installation von Smart Home Geräten</div>
            <div class="em-card-text">Vernetzte Thermostate, Beleuchtung, Kameras und WLAN-Mesh für lückenlosen Empfang im ganzen Haus.</div>
            <div class="em-card-more">Mehr erfahren &rarr;</div>
          </div>
        </a>
      </div>
    </div>
  </section>
</Base>
