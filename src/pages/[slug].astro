---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.js';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const indexFile = path.resolve('content/reviews/index.json');
  const items = JSON.parse(fs.readFileSync(indexFile, 'utf-8'));
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { meta: item }
  }));
}

const { meta } = Astro.props;
const articleFile = path.resolve(`content/reviews/${meta.slug}/article.html`);
const contentHtml = fs.readFileSync(articleFile, 'utf-8');

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  'headline': meta.title,
  'datePublished': meta.date,
  'dateModified': meta.modified || meta.date,
  'author': {
    '@type': 'Person',
    'name': site.author.name,
    'url': `${site.url}/oliver-bechstein/`
  },
  'publisher': {
    '@type': 'Organization',
    'name': site.name,
    'logo': {
      '@type': 'ImageObject',
      'url': `${site.url}/bilder/logo-2020-jpg.webp`
    }
  },
  'image': meta.featured_image ? [`${site.url}${meta.featured_image}`] : undefined,
  'description': meta.excerpt || site.tagline
};
---
<Base
  title={meta.title}
  description={meta.excerpt || site.tagline}
  image={meta.featured_image}
  path={`/${meta.slug}/`}
  type="article"
  jsonld={jsonld}
>
  <article class="em-article-wrap">
    <header class="em-article-header">
      <div class="em-pill">{meta.categories[0] || 'Praxistest'}</div>
      <h1 style="font-size: clamp(30px, 4vw, 44px); margin-top: 14px;">{meta.title}</h1>
      <div class="em-article-meta">
        <span>Von <strong>{meta.author}</strong></span>
        <span>&bull;</span>
        <time datetime={meta.date}>{meta.date}</time>
        <span>&bull;</span>
        <span>Geprüfter Praxistest</span>
      </div>
    </header>

    <div class="em-content" set:html={contentHtml} />

    <section class="em-author-box">
      <img src={site.author.image} alt={site.author.name} />
      <div>
        <div class="em-author-title">Über den Autor: {site.author.name}</div>
        <p class="em-author-bio">{site.author.bio}</p>
      </div>
    </section>
  </article>
</Base>
